<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Search Saved Meals"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/local_search_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter part of a meal or ingredient"
        android:inputType="text"
        android:maxLines="1" />

    <Button
        android:id="@+id/local_search_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Search Local Database"
        android:layout_marginTop="12dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/local_results_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textIsSelectable="true"
            android:autoLink="web"
            android:paddingBottom="24dp" />

    </ScrollView>

    <Button
        android:id="@+id/exit_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Exit" />

</LinearLayout>